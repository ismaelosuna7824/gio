// Signing defaults for the Gio target: a zero-setup, ad-hoc "Sign to Run Locally" build.
// Do not edit this file to use your own team. Copy Signing.local.xcconfig.example to
// Signing.local.xcconfig (git-ignored) and put your values there instead.

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
PRODUCT_BUNDLE_IDENTIFIER = dev.gio.windowmanager

// Must stay the last line so the local file overrides the defaults above.
#include? "Signing.local.xcconfig"
